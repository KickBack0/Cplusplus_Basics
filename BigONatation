int binarySearch(const std::vector<int>&v,int target){
    int low=0;
    int high=v.size()-1;
    while(low<=high){
        int mid=low+(high-low)/2;
        if(v.at(mid)==target){
            return mid;
        }
        if(v.at(mid)<target){
            low=mid+1;
        }
        else{
            high=mid-1;
        }
    }
    return false;
}
int findMax(const std::vector<int>&v){
    int max=v.at(0);
    for(int i:v){
        if(i>max){
            max=i;
        }
    }
    return max;
}
